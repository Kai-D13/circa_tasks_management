# Ảnh review UI chụp bằng e2e/ui-review-shots.spec.ts — chụp màn hình THẬT nên
# có tên/email người dùng (sidebar footer, cột người thực hiện). Bằng chứng gửi
# stakeholder qua kênh nội bộ, KHÔNG BAO GIỜ commit.
docs/ui/review-r2/

# Ảnh baseline mobile staff chụp bằng e2e/ui-mobile-baseline.spec.ts — cùng lý
# do: dữ liệu thật (tên nhân viên, tên khách trên toa thuốc). KHÔNG commit.
docs/ui/mobile-baseline/

# storageState của Playwright (e2e/auth.setup.ts) — chứa cookie phiên Supabase
# đang còn hiệu lực, tức là credential sống. KHÔNG BAO GIỜ commit.
webapp/e2e/.auth/

# Secrets — service-account keys / credential exports. NEVER commit.
*-gcs.tar
*-sa
circa-v2-sa
*sa*.json
*.key
*.pem
