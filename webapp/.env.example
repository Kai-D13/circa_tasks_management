# Copy this file to .env.local and fill in real values for local dev.
# .env.local is gitignored. For production, set the same vars in Coolify's UI
# (Environment Variables tab). NEXT_PUBLIC_* must additionally be set as
# Build Arguments in Coolify because Next.js inlines them at build time.

# ─── Public (browser-exposed, safe to ship in client bundle) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Server-only (NEVER prefix with NEXT_PUBLIC_) ─────────────────────────────
# Found in Supabase dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Random 32+ char secret. Required header for /api/cron/* route handlers.
# Generate: openssl rand -hex 32
CRON_SECRET=replace-with-a-random-32-plus-char-string

# ─── BigQuery (targets feed) — server-only ────────────────────────────────────
# Service-account JSON (raw or base64). base64 recommended (Coolify mangles JSON).
# Used by BOTH /api/cron/pull-targets (weekly, store_weekly_targets) and
# /api/cron/pull-kpi-targets (KPI v2 day/week/month, store_kpi_targets).
BQ_SERVICE_ACCOUNT_KEY=
# Optional override of the legacy weekly query (DEFAULT_QUERY) only.
# BQ-V2 r2 (audit P2#4): BQ_KPI_QUERY đã BỎ — KPI_AGGREGATE_QUERY là contract
# version-control bằng Git, không override được qua env.
# BQ_QUERY=

# ─── Referral feed (Google Sheet pull) — server-only ──────────────────────────
# /api/cron/pull-referrals reads this Sheet (BI auto-extracts BigQuery → Sheet)
# and replaces staff_referrals. Reuses BQ_SERVICE_ACCOUNT_KEY (Sheets read-only
# scope) — share the Sheet with the SA email as Viewer + enable Sheets API.
REFERRAL_SHEET_ID=
REFERRAL_SHEET_RANGE=Sheet1
# Safety floor: abort the replace-all if the Sheet yields fewer valid rows than
# this (also aborts on a >50% shrink vs. stored). Protects against a broken Sheet.
# Set to a realistic prod floor (≈ expected staff/referral count), NOT 1.
REFERRAL_MIN_ROWS=20

# ─── Inventory → TRF feed (Google Sheet pull) — server-only ───────────────────
# /api/cron/pull-inventory-trf reads this Sheet (cols: pos_code_check,
# pos_name_check, TRF_code, reason, created_by) and creates store-level TRF tasks.
# Reuses BQ_SERVICE_ACCOUNT_KEY (Sheets read-only) — share the Sheet with the SA.
INVENTORY_TRF_SHEET_ID=
INVENTORY_TRF_SHEET_RANGE=final_need_to_check
INVENTORY_TRF_DEADLINE_HOURS=48
# REQUIRED: a Cycle Count system admin user id (role='admin' + department_id =
# Cycle Count). The cron aborts (503) if unset/invalid. Owns the created tasks
# (overdue notifications + department badge).
INVENTORY_TRF_CREATED_BY=

# ─── Tasks: lưu trữ / khôi phục hàng loạt qua RPC (T1-B, migration 117) ──────
# ON = nút "Lưu trữ / Khôi phục đã chọn" trên /tasks gọi rpc_set_tasks_archived
# (một transaction, kiểm quyền từng task ở DB). OFF = nút ẩn + action trả lỗi
# trước mọi đọc/ghi — KHÔNG có đường ghi cũ để quay về. Chỉ bật SAU khi DB đã
# chạy 117 + VERIFY quyền RPC + QA. Tắt = tạm ngừng thao tác hàng loạt.
TASKS_ARCHIVE_RPC_ENABLED=false

# ─── KPI Campaign module (Phase 1) — server-only feature gate ─────────────────
# Super-admin campaign config (target + commission tiers per store). Keep OFF in
# production until QA sign-off — hides the "Chiến dịch" nav + guards the routes.
KPI_CAMPAIGN_ENABLED=false
# When true, new campaigns default to is_test=true (isolate from Staff/SM in QA).
# MUST be false in production — otherwise every campaign created is born is_test
# and stays invisible to Staff/SM. Set true only on a QA environment.
KPI_CAMPAIGN_TEST_MODE=false
# GMV Affiliate metric trong campaign (plan v1.1): OFF ẩn checkbox ở wizard.
# CHỈ bật sau khi migration 092 + backfill affiliate_orders + đối soát pass.
KPI_AFFILIATE_ENABLED=false
# Campaign "Số khách Affiliate" (metric_type=affiliate_customer_count, mig 103):
# OFF ẩn option ở wizard + engine giữ snapshot + tạo campaign bị từ chối.
# ĐỘC LẬP với KPI_AFFILIATE_ENABLED. CHỈ bật sau khi: migration 103 + backfill
# account_id (full sync ×2, delivered_missing_account_id_count=0) + QA script
# 103 ALL PASS + đối soát khách distinct pass.
KPI_AFFILIATE_CUSTOMER_ENABLED=false

# Loại chiến dịch "Chất lượng bán hàng" (mig 106): đánh giá đồng thời Số đơn
# Offline và AOV, mỗi chỉ số một mục tiêu riêng; ĐẠT khi CẢ HAI cùng chạm mục
# tiêu (contract 12/08 — KHÔNG còn tỷ trọng 90/10 và KHÔNG còn sàn).
# Gate DUY NHẤT của loại này (độc lập 2 flag trên).
# Bật SAU khi chạy migration 106 + đối soát 3 sample Finance trên prod.
KPI_ORDER_AOV_CAMPAIGN_ENABLED=false

# ─── Chronic prescription order sync (Google Sheet, cron) ─────────────────────
# Sheet "Circa_prescription" (BigQuery-fed) — order/customer data keyed by DHC.
# Share the Sheet with the BQ_SERVICE_ACCOUNT_KEY service-account email (Viewer).
PRESCRIPTION_ORDER_SHEET_ID=1ia_TIFzOx3KsKlmLnTdYOd2VHTr8IMmyX0V2ortmdFs
PRESCRIPTION_ORDER_SHEET_RANGE=order_data

# ─── Microsoft Teams (n8n relay) — server-only ────────────────────────────────
N8N_TEAMS_TASK_WEBHOOK_URL=

# ─── Google Cloud Storage (file/image uploads) — server-only ──────────────────
# STORAGE_PROVIDER: 'gcs' routes NEW uploads to GCS; anything else = Supabase.
# Keep 'supabase' until the GCS code is deployed AND QA'd, then flip to 'gcs'.
STORAGE_PROVIDER=supabase
GCS_BUCKET=duocsi-circa-vn
GCP_PROJECT_ID=circa-v2
# Public base for serving (swap to a Cloud CDN domain later — env-only change).
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/duocsi-circa-vn
# Service-account JSON (raw or base64). base64 recommended. objectAdmin on the bucket.
GCS_SA_KEY=

# Affiliate program (Circa Online MongoDB, read-only — dev qua VPN netbird; prod dùng chuỗi PUBLIC circa-online.ge5yfl.mongodb.net sau khi DevOps allowlist IP server)
MONGODB_AFFILIATE_URI=
# Ba flag ĐỘC LẬP (audit P2): tắt cái này không bật cái kia
# AFFILIATE_ENABLED = UI (sidebar, /affiliate, card staff)
AFFILIATE_ENABLED=false
# AFFILIATE_SYNC_ENABLED = cron pull-affiliate-orders — tách khỏi UI để chạy
# backfill khi UI còn tắt (trình tự rollout F5: deploy tắt → backfill → đối soát → bật UI)
AFFILIATE_SYNC_ENABLED=false
# Referral đã NGƯNG — false = chặn mọi entry point (page/upload/cron); data giữ nguyên
REFERRAL_ENABLED=false

# ─── CRM-CSKH (Chăm sóc khách hàng) — server-only, mặc định OFF ──────────────
# planning/SPEC.md B0. Hai cờ ĐỘC LẬP; chỉ bật ở bước rollout B6 (sau migration
# 114 + VERIFY + dry-run N3 ×2 + QA). Chỉ đúng chuỗi 'true' mới bật.
# CARE_ENABLED = nav/route/action CRM (OFF = module vô hình, /tasks không đổi).
CARE_ENABLED=false
# CARE_SYNC_ENABLED = cron care-period-close + care-orders-sync (Coolify, B5).
CARE_SYNC_ENABLED=false
# CARE_IMPORT_CANCEL_ENABLED = nút + action huỷ file import chưa có lượt (D1, Q-149–163). Cần CARE_ENABLED và
# migration 115 đã chạy + VERIFY + QA is_test. Cờ OFF KHÔNG hoàn tác thay đổi DB của 115 (finalize/close/trigger).
CARE_IMPORT_CANCEL_ENABLED=false
# E — đơn N3 xác thực sau import (thiết kế E0 r3.4). Cần CARE_ENABLED và migration 116 đã chạy + VERIFY + trial.
# Cờ OFF KHÔNG hoàn tác thay đổi DB của 116 (trigger trên care_tasks/care_customers, REVOKE DELETE của service_role).
# CARE_ORDER_LINKS_SYNC_ENABLED = route lượt thường /api/cron/care-order-links-sync + lượt chốt /api/cron/care-order-links-close.
CARE_ORDER_LINKS_SYNC_ENABLED=false
# CARE_ORDER_LINKS_UI_ENABLED = hiển thị đơn sau import trên /care/reports, /care/orders, /care/my, chi tiết task.
CARE_ORDER_LINKS_UI_ENABLED=false
# CARE_ORDER_LINKS_TRIAL_ENABLED = route trial /api/cron/care-order-links-trial (không ghi link/coverage/trạng thái). TẠM — gỡ sau trial.
CARE_ORDER_LINKS_TRIAL_ENABLED=false
# Bảng/view đơn N3 dạng project.dataset.table (data contract r3.2). Để trống tới
# khi BI/operator xác nhận tên bảng + quyền SA trước B5; trống = sync fail-closed.
# Đọc bằng BQ_SERVICE_ACCOUNT_KEY ở trên.
CARE_BQ_ORDERS_TABLE=
# Trần byte file Excel import (mặc định 8MB; khoảng hợp lệ 64KB–10MB vì proxy.ts
# cắt body > 10MB).
CARE_IMPORT_MAX_BYTES=8388608
# CARE_ZALO_LINK_ENABLED = nút Zalo (https://zalo.me/<SĐT của task>) + "SMS dự phòng" trên chi tiết task của dược sĩ
# (lát C, Q-154). Cần CARE_ENABLED; không có migration. OFF = giữ nguyên Gọi khách / Nhắn tin.
CARE_ZALO_LINK_ENABLED=false
# B6-qa-ui — chế độ QA browser trên dev server LOCAL (không có ở đây, không đặt ở
# Coolify, không đặt trong BẤT KỲ file .env*): CARE_QA_UI=YES + CARE_QA_UI_BIND do
# `node scripts/care-qa-fixture.mjs serve` tự đặt trong process. Chỉ có hiệu lực khi
# NODE_ENV=development (build production luôn tắt). Khai trong file .env* ⇒ CRM tắt.

# ─── E2E/QA — CHỈ đặt trong .env.local, KHÔNG đặt ở Coolify ───────────────────
# Tên biến (không bao giờ commit giá trị):
#   E2E_STAFF_* · E2E_QLCH_* · E2E_SM_* · E2E_SUPER_* (EMAIL/PASSWORD) — spec cũ
#     đọc process.env, phải export ở shell trước khi chạy Playwright.
#   E2E_MKT_ADMIN_EMAIL / E2E_MKT_ADMIN_PASSWORD — admin phòng Marketing (CRM);
#     spec CRM đọc qua e2e/envLocal.ts (process env > .env.local), chạy thẳng
#     trên PowerShell, không cần source file.

# ── CMS theo sản phẩm (docs/cms/SPEC.md §9) — server-only, KHÔNG NEXT_PUBLIC ─────
# View nguồn BigQuery dạng project.dataset.table, SA của app (BQ_SERVICE_ACCOUNT_KEY) phải đọc được.
# Trống ⇒ cron / bootstrap báo thiếu cấu hình, KHÔNG query. Không trỏ nguồn thô ngoài quyền SA.
# Nguồn BI thật (operator 04/11, VIEW): Product Master = lakehouse-prod-394907.buymed_tech.tech__dim_circa_growth_cms_product_master ;
# dòng đơn = lakehouse-prod-394907.buymed_tech.tech__dim_circa_growth_cms_order (cột vật lý employee_email — app đọc AS seller_email).
CMS_BQ_PRODUCTS_TABLE=
CMS_BQ_SALES_TABLE=
# Cờ CMS — mặc định OFF (chỉ đúng chuỗi "true" mới bật). Server-only.
#   CMS_PROGRAM_ENABLED: chương trình, danh mục, import, tư vấn, cron /api/cron/pull-cms-products (P1).
#   CMS_EARNINGS_ENABLED: số CMS thực tế — cron /api/cron/sync-cms-sales + hiển thị kết quả (P2; chỉ chạy khi CẢ
#     CMS_PROGRAM_ENABLED bật). Chương trình thật chưa công bố tiền khi Q-206 HOLD (lib/cms/releaseGate.ts).
#   CMS_LOCK_ENABLED: chốt kỳ / chi trả (P3a) — chỉ có hiệu lực khi CẢ CMS_PROGRAM_ENABLED + CMS_EARNINGS_ENABLED bật; mặc định OFF.
#   Nạp Product Master lần đầu trước khi bật cờ: node scripts/cms-bootstrap-products.mjs (operator, dry-run mặc định).
#   Đồng bộ bán một chương trình theo lệnh operator: node scripts/cms-sales-sync.mjs --program=<uuid> (dry-run mặc định).
#   CMS_SOURCE_CAPTURE_ENABLED: lưu lớp NGUỒN của run bán (migration 124 — mọi dòng hợp lệ adapter đọc, kể cả ONLINE / chưa
#     hoàn tất, 14 trường thô) để chứng nhận đối soát nguồn. Chỉ bật SAU khi DB đã chạy 124; app vẫn đòi run_open trả
#     source_schema = 1 (thiếu ⇒ đóng run lỗi SOURCE_SCHEMA_UNSUPPORTED). Rollback 124 ⇒ tắt cờ cùng lúc. Mặc định OFF.
CMS_PROGRAM_ENABLED=false
CMS_EARNINGS_ENABLED=false
CMS_LOCK_ENABLED=false
CMS_SOURCE_CAPTURE_ENABLED=false
# CMS_IMPORT_V2_ENABLED (CMS đơn giản S1 + S2, PM 08/11): import mẫu mức cố định 7 cột (mỗi SP một mức / đơn vị, không target) +
#   kiểm K theo dữ liệu bán khi import (BigQuery CMS_BQ_SALES_TABLE, dry-run + trần 2 GB). Chỉ hiệu lực khi CMS_PROGRAM_ENABLED bật.
#   OFF ⇒ import như trước (chỉ mẫu 9 cột, không kiểm K). Không cần migration. Mặc định OFF.
CMS_IMPORT_V2_ENABLED=false
